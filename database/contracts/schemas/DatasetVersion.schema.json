          "type": "string"
        },
        "relations": {
          "items": {
            "enum": [
              "match",
              "uncertain",
              "different"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Relations",
          "type": "array"
        },
        "schema_version": {
          "const": "source-selection-1.0",
          "default": "source-selection-1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "SourceSelectionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "dataset_version_id": {
      "title": "Dataset Version Id",
      "type": "string"
    },
    "observations": {
      "title": "Observations",
      "type": "integer"
    },
    "periods": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Periods",
      "type": "object"
    },
    "policy": {
      "$ref": "#/$defs/SourceSelectionPolicy"
    },
    "published_at": {
      "title": "Published At",
      "type": "string"
    },
    "revision": {
