{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platesg.local/schemas/metric-dictionary.v1.json",
  "title": "PlatESG versioned product metric dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dictionary_version",
    "comparison_contract_version",
    "profile_id",
    "profile_version",
    "source_catalog_id",
    "source_catalog_hash",
    "source_sha256",
    "selection_terms",
    "metrics"
  ],
  "properties": {
    "dictionary_version": {
      "const": "1.0.0"
    },
    "comparison_contract_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string"
    },
    "profile_version": {
      "type": "string"
    },
    "source_catalog_id": {
      "type": "string"
    },
    "source_catalog_hash": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "selection_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_core",
        "platform_major"
      ],
      "properties": {
        "package_core": {
          "type": "string"
        },
        "platform_major": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 55,
      "maxItems": 55,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "label_zh",
          "value_type",
          "canonical_unit",
          "unit_dimension",
          "required_dimensions",
          "comparison_dimensions",
          "fixed_dimensions",
          "dimension_constraints",
          "required_context_fields",
          "typed_context_constraints",
          "description",
          "aggregation",
          "exclusions",
          "comparison_conditions",
          "value_role",
          "comparison_mode",
          "definition_version",
          "source_datapoint_id",
          "original_name",
          "original_data_type",
          "topic",
          "readiness",
          "definition_status",
          "package_core",
          "platform_major",
          "standard_binding",
          "source_measurement_contract",
          "source_reference"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "label_zh": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "enum": [
              "numeric",
              "statement"
            ]
          },
          "canonical_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit_dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "comparison_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "fixed_dimensions": {
            "type": "object"
          },
          "dimension_constraints": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allowed_values"
              ],
              "properties": {
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "required_context_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "typed_context_constraints": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allowed_values"
              ],
              "properties": {
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "type": "string",
            "minLength": 1
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "comparison_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "value_role": {
            "enum": [
              "actual",
              "context"
            ]
          },
          "comparison_mode": {
            "type": "string",
            "minLength": 1
          },
          "unresolved_dimension_policy": {
            "enum": [
              "not_stated",
              "block"
            ]
          },
          "normalization": {
            "enum": [
              "compatible_unit_only",
              "percent_to_ratio",
              "preserve"
            ]
          },
          "value_constraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum": {
                "type": "string"
              },
              "maximum": {
                "type": "string"
              }
            }
          },
          "definition_version": {
            "type": "string",
            "minLength": 1
          },
          "source_datapoint_id": {
            "type": "string",
            "minLength": 1
          },
          "original_name": {
            "type": "string",
            "minLength": 1
          },
          "original_data_type": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "readiness": {
            "enum": [
              "ready",
              "planned"
            ]
          },
          "definition_status": {
            "enum": [
              "authored_draft",
              "planned_proposal"
            ]
          },
          "package_core": {
            "const": true
          },
          "platform_major": {
            "const": true
          },
          "standard_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package_id",
              "package_version",
              "metric_id",
              "digest"
            ],
            "properties": {
              "package_id": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metric_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "source_measurement_contract": {
            "type": [
              "object",
              "null"
            ]
          },
          "source_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "catalog_id",
              "workbook_sha256",
              "row_sha256",
              "source_sheet",
              "source_row",
              "paragraph",
              "related_ar",
              "conditional_or_alternative",
              "may"
            ],
            "properties": {
              "catalog_id": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "workbook_sha256": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "row_sha256": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "source_sheet": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "source_row": {
                "type": "integer",
                "minimum": 1
              },
              "paragraph": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "related_ar": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "conditional_or_alternative": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "may": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              }
            }
          },
          "statement_polarity": {
            "const": "negative_absence"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "readiness": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "properties": {
                "definition_status": {
                  "const": "authored_draft"
                },
                "source_measurement_contract": {
                  "type": "object"
                },
                "standard_binding": {
                  "properties": {
                    "package_version": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d+\\.\\d+$"
                    },
                    "metric_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "definition_status": {
                  "const": "planned_proposal"
                },
                "source_measurement_contract": {
                  "type": "null"
                },
                "standard_binding": {
                  "properties": {
                    "package_version": {
                      "type": "null"
                    },
                    "metric_id": {
                      "type": "null"
                    },
                    "digest": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
