{
  "rule_version": "esg-units-1.5.6",
  "schema_version": "esg-unit-conversions-v1",
  "scope": "Versioned explicit units for built E1-E3 major concepts and optional extensions; unit conversion never implies concept equivalence or a reporting method. Water reported in mass is read as volume at unit density (1 t = 1 m3); the printed unit and value stay untouched in the record. kWh-family Chinese colloquial forms (度, 度电, 千度, 万度, 亿度) are explicit aliases of their stated scale. Upper-case K mass forms (Kg, KG) are explicit aliases of kilogram, metric ton 公吨 is an explicit alias of tonne, and intensity per million revenue is an explicit scale of per ten-thousand revenue.",
  "alias_matching": "Remove whitespace and match explicitly listed aliases with case preserved, because SI prefixes M/m can change scale; never infer a missing or unknown source unit from an approved canonical unit.",
  "decimal_policy": {
    "finite_conversion": "Exact PostgreSQL numeric multiplication by the declared decimal multiplier.",
    "non_terminating_conversion": "PostgreSQL numeric rational division with a numerator carrying at least 40 decimal places; preserve the original reported value and unit.",
    "minimum_rational_decimal_places": 40,
    "bounds": "Apply each metric definition's value_constraints; the ratio unit does not itself imply [0,1]."
  },
