          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "distinguish_from": {
          "items": {
            "type": "string"
          },
          "title": "Distinguish From",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRequirement"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
