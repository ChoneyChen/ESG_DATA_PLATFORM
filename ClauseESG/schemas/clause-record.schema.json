        "exact_labels": {
          "items": {
            "type": "string"
          },
          "title": "Exact Labels",
          "type": "array"
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Exclusions",
          "type": "array"
        },
        "group_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Group Id",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "organization": {
          "$ref": "#/$defs/OrganizationSpec"
        },
        "output_scopes": {
          "items": {
            "$ref": "#/$defs/OutputScope"
          },
          "minItems": 1,
          "title": "Output Scopes",
          "type": "array"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "purposes": {
          "$ref": "#/$defs/ClausePurposes"
        },
        "readiness": {
          "default": "ready",
          "enum": [
            "ready",
            "blocked"
          ],
          "title": "Readiness",
          "type": "string"
        },
        "reading": {
          "$ref": "#/$defs/ReadingContract"
        },
        "relationships": {
          "$ref": "#/$defs/ClauseRelationships"
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalProfile"
        },
        "schema_version": {
          "const": "clause-contract-1.3",
          "default": "clause-contract-1.3",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ValueContract"
        }
      },
      "required": [
        "clause_key",
        "group_id",
        "labels",
        "definition",
        "exclusions",
        "data_kind",
        "value",
        "output_scopes",
        "reading",
        "retrieval",
        "evidence",
        "organization",
        "clause_digest",
        "purposes"
      ],
      "title": "ClauseContract",
      "type": "object"
