          "type": "string"
        },
        "require_measurement_meaning": {
          "const": true,
          "default": true,
          "title": "Require Measurement Meaning",
          "type": "boolean"
        },
        "unlisted_categories": {
          "const": "preserve_literal",
          "default": "preserve_literal",
          "title": "Unlisted Categories",
          "type": "string"
        }
      },
      "title": "CapturePolicy",
      "type": "object"
    },
