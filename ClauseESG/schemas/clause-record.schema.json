          "title": "Minimum Reports",
          "type": "integer"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/AcceptanceSample"
          },
          "title": "Samples",
          "type": "array"
        }
      },
      "title": "AcceptanceProfile",
      "type": "object"
    },
    "AcceptanceSample": {
      "additionalProperties": false,
      "description": "An expectation bound to a real run; it is evidence of behaviour, not a value source.",
      "properties": {
        "expected_absent": {
          "default": false,
          "title": "Expected Absent",
          "type": "boolean"
        },
        "expected_value_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value Raw"
        },
        "report_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Label"
        },
        "run_ref": {
          "minLength": 1,
          "title": "Run Ref",
          "type": "string"
        },
        "scope_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Id"
        }
      },
      "required": [
        "run_ref"
      ],
      "title": "AcceptanceSample",
      "type": "object"
    },
    "CapturePolicy": {
      "additionalProperties": false,
      "description": "Raw reception owns no mandatory business identity or normalized unit.",
      "properties": {
        "missing_metadata": {
          "const": "retain",
          "default": "retain",
          "title": "Missing Metadata",
          "type": "string"
        },
        "period_policy": {
          "const": "all_reported",
          "default": "all_reported",
