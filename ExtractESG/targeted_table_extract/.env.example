ESG_TARGETED_BACKEND_HOST=127.0.0.1
ESG_TARGETED_BACKEND_PORT=18180

# Colon-separated Document IR output roots. Defaults also discover the workspace v2 output.
# ESG_TARGETED_IR_ROOTS=/path/to/document_ir_output:/another/path

# Optional overrides. Defaults point to ~/Desktop/model.
# NUEXTRACT_MODEL_PATH=/path/to/NuExtract3-mlx-4bits
# QWEN3_EMBEDDING_MODEL_PATH=/path/to/Qwen3-Embedding-0.6B-8bit

ESG_TARGETED_REQUIRE_READY_IR=true
ESG_TARGETED_RETRIEVAL_TOP_K=12
ESG_TARGETED_RETRIEVAL_OBJECT_TOP_N=3
ESG_TARGETED_PACKET_MAX_CHARS=16000
ESG_TARGETED_PACKET_MAX_SPANS=40
ESG_TARGETED_PACKET_MAX_GROUPS=12
ESG_TARGETED_PACKET_MAX_CANDIDATES=80
ESG_TARGETED_PACKET_MAX_IMAGES=1
ESG_TARGETED_MODEL_MAX_TOKENS=4096
ESG_TARGETED_MODEL_MIN_OUTPUT_TOKENS=512
ESG_TARGETED_MODEL_MAX_INPUT_TOKENS=8192
ESG_TARGETED_MODEL_TIMEOUT_SECONDS=120
ESG_TARGETED_MODEL_RETRIES=1

# Optional cloud VLM channel. Keep the key in the environment, never in source files.
# QINIU_API_KEY=replace-me
ESG_TARGETED_QINIU_BASE_URL=https://api.qnaigc.com/v1
ESG_TARGETED_QINIU_MODEL=qwen3.5-397b-a17b
ESG_TARGETED_QINIU_TIMEOUT_SECONDS=240
ESG_TARGETED_QINIU_MAX_OUTPUT_TOKENS=16384
ESG_TARGETED_QINIU_MAX_IMAGE_BYTES=7500000

# Bounded single-visual-object profile used only by the Qiniu cloud channel.
ESG_TARGETED_CLOUD_PACKET_MAX_CHARS=72000
ESG_TARGETED_CLOUD_PACKET_MAX_SPANS=240
ESG_TARGETED_CLOUD_PACKET_MAX_GROUPS=24
ESG_TARGETED_CLOUD_PACKET_MAX_CANDIDATES=480
ESG_TARGETED_CLOUD_PACKET_MAX_IMAGES=1
