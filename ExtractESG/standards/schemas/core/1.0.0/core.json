        {"field_id": "evidence_set_id", "value_type": "identifier", "required": true, "description": "Evidence set supporting this assertion."},
        {"field_id": "confidence", "value_type": "decimal", "required": false, "nullable": true, "description": "Machine confidence from zero to one."},
        {"field_id": "review_status", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.review-status", "description": "Review state."}
      ]
