        {"field_id": "observation_id", "value_type": "identifier", "required": true, "description": "Stable quantitative observation identifier."},
        {"field_id": "task_id", "value_type": "identifier", "required": true, "description": "Owning reporting task."},
        {"field_id": "metric_id", "value_type": "identifier", "required": true, "description": "Namespaced metric identifier."},
        {"field_id": "value_origin", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.value-origin", "description": "Reported or derived origin."},
        {"field_id": "value_raw", "value_type": "string", "required": true, "description": "Value exactly as represented by the report."},
        {"field_id": "comparator", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.comparator", "description": "Exact, approximate, bound or range comparator."},
        {"field_id": "value_numeric", "value_type": "decimal", "required": false, "nullable": true, "description": "Typed exact or central numeric value."},
        {"field_id": "value_lower", "value_type": "decimal", "required": false, "nullable": true, "description": "Typed lower bound."},
        {"field_id": "value_upper", "value_type": "decimal", "required": false, "nullable": true, "description": "Typed upper bound."},
        {"field_id": "unit_raw", "value_type": "string", "required": false, "nullable": true, "description": "Unit exactly as represented by the report."},
        {"field_id": "unit_id", "value_type": "identifier", "required": false, "nullable": true, "description": "Controlled unit identifier."},
        {"field_id": "reporting_period_raw", "value_type": "string", "required": false, "nullable": true, "description": "Reporting period exactly as represented by the report."},
        {"field_id": "reporting_year", "value_type": "year", "required": false, "nullable": true, "description": "Reporting year when the period is annual."},
        {"field_id": "period_start", "value_type": "date", "required": false, "nullable": true, "description": "Reporting period start."},
        {"field_id": "period_end", "value_type": "date", "required": false, "nullable": true, "description": "Reporting period end."},
        {"field_id": "reporting_boundary", "value_type": "string", "required": false, "nullable": true, "description": "Original reporting boundary or scope."},
        {"field_id": "evidence_set_id", "value_type": "identifier", "required": true, "description": "Evidence set supporting this observation."},
        {"field_id": "confidence", "value_type": "decimal", "required": false, "nullable": true, "description": "Machine confidence from zero to one."},
        {"field_id": "review_status", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.review-status", "description": "Review state."}
