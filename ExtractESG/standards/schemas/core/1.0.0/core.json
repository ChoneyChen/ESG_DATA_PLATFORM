        {"field_id": "task_id", "value_type": "identifier", "required": true, "description": "Stable task identifier."},
        {"field_id": "report_id", "value_type": "identifier", "required": true, "description": "Upstream report reference."},
        {"field_id": "document_id", "value_type": "identifier", "required": true, "description": "Immutable source document identifier."},
        {"field_id": "ir_run_id", "value_type": "identifier", "required": true, "description": "Document IR run identifier."},
        {"field_id": "ir_revision", "value_type": "integer", "required": true, "description": "Document IR revision."},
        {"field_id": "package_id", "value_type": "identifier", "required": true, "description": "Standard package identifier."},
        {"field_id": "package_version", "value_type": "string", "required": true, "description": "Standard package semantic version."},
        {"field_id": "metric_id", "value_type": "identifier", "required": true, "description": "Namespaced metric identifier."},
        {"field_id": "materiality_status", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.materiality-status", "description": "Materiality state."},
        {"field_id": "applicability_status", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.applicability-status", "description": "Applicability state."},
        {"field_id": "found_status", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.found-status", "description": "Disclosure finding state."},
        {"field_id": "result_count", "value_type": "integer", "required": true, "description": "Number of accepted result records."},
        {"field_id": "evidence_count", "value_type": "integer", "required": true, "description": "Number of attached evidence records."},
        {"field_id": "uncertainty_reason", "value_type": "text", "required": false, "nullable": true, "description": "Bounded reason when the task cannot be resolved."},
        {"field_id": "review_status", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.review-status", "description": "Review state."},
        {"field_id": "task_status", "value_type": "enum", "required": true, "code_set_id": "extractesg.core.codeset.task-status", "description": "Task execution state."}
      ]
    },
    {
      "record_type": "quantitative_observation",
      "primary_key": "observation_id",
      "description": "One quantitative value for one metric, period, boundary and dimension combination.",
