  "record_types": [
    {
      "description": "One selected standard datapoint for one report and one immutable IR revision.",
      "fields": [
        {
          "description": "Stable task identifier.",
          "field_id": "task_id",
          "required": true,
          "value_type": "identifier"
        },
        {
          "description": "Upstream report reference.",
          "field_id": "report_id",
          "required": true,
          "value_type": "identifier"
        },
        {
          "description": "Immutable source document identifier.",
          "field_id": "document_id",
          "required": true,
          "value_type": "identifier"
        },
        {
          "description": "Document IR run identifier.",
          "field_id": "ir_run_id",
          "required": true,
          "value_type": "identifier"
        },
        {
          "description": "Document IR revision.",
          "field_id": "ir_revision",
          "required": true,
          "value_type": "integer"
        },
        {
          "description": "Standard package identifier.",
          "field_id": "package_id",
          "required": true,
          "value_type": "identifier"
        },
        {
          "description": "Standard package semantic version.",
          "field_id": "package_version",
          "required": true,
          "value_type": "string"
        },
        {
          "description": "Namespaced metric identifier.",
          "field_id": "metric_id",
          "required": true,
          "value_type": "identifier"
        },
        {
          "code_set_id": "extractesg.core.codeset.materiality-status",
          "description": "Materiality state.",
          "field_id": "materiality_status",
          "required": true,
          "value_type": "enum"
        },
        {
          "code_set_id": "extractesg.core.codeset.applicability-status",
          "description": "Applicability state.",
          "field_id": "applicability_status",
          "required": true,
          "value_type": "enum"
        },
        {
          "code_set_id": "extractesg.core.codeset.found-status",
          "description": "Disclosure finding state.",
          "field_id": "found_status",
          "required": true,
          "value_type": "enum"
        },
        {
          "description": "Number of accepted result records.",
          "field_id": "result_count",
          "required": true,
          "value_type": "integer"
        },
        {
          "description": "Number of attached evidence records.",
          "field_id": "evidence_count",
          "required": true,
          "value_type": "integer"
        },
        {
          "description": "Bounded reason when the task cannot be resolved.",
