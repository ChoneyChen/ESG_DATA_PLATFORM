{
  "additionalProperties": false,
  "properties": {
    "catalog_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Catalog Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "profile_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Profile Version",
      "type": "string"
    },
    "selection_kind": {
      "enum": [
        "platform_major",
        "package_core",
        "full"
      ],
      "title": "Selection Kind",
      "type": "string"
    },
    "selection_reason": {
      "title": "Selection Reason",
      "type": "string"
    },
    "source_datapoint_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Datapoint Ids",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "label",
    "selection_kind",
    "catalog_id",
    "source_datapoint_ids",
    "selection_reason"
  ],
  "title": "ExtractionProfile",
  "type": "object"
}
