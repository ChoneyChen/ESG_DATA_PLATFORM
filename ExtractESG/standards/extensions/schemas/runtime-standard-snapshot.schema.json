{
  "$defs": {
    "ComparisonContract": {
      "additionalProperties": false,
      "properties": {
        "required_axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Axes",
          "type": "array"
        },
        "allowed_values": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Allowed Values",
          "type": "object"
        },
        "missing_or_unknown_policy": {
          "const": "display_only",
          "default": "display_only",
          "title": "Missing Or Unknown Policy",
          "type": "string"
        }
      },
      "required": [
        "required_axes"
      ],
      "title": "ComparisonContract",
      "type": "object"
    },
    "CompiledExtension": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "project-extension-release-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/ExtensionDefinition"
        },
        "definition_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Digest",
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/ExtensionApproval"
        },
        "release_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Release Digest",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "definition",
        "definition_digest",
        "approval",
        "release_digest"
      ],
      "title": "CompiledExtension",
      "type": "object"
    },
    "ExtensionApproval": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "project-extension-approval-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "approval_id": {
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "proposal_id": {
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "definition_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Digest",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "actor_ref": {
          "minLength": 1,
          "title": "Actor Ref",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "approval_id",
        "proposal_id",
        "definition_digest",
        "decision",
        "actor_ref",
        "reason",
        "decided_at"
      ],
      "title": "ExtensionApproval",
      "type": "object"
    },
    "ExtensionDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "project-extension-definition-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "extension_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Extension Id",
          "type": "string"
        },
        "definition_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Definition Version",
          "type": "string"
        },
        "clause_kind": {
          "const": "project_extension",
          "default": "project_extension",
          "title": "Clause Kind",
          "type": "string"
        },
        "parent_package_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Parent Package Id",
          "type": "string"
        },
        "parent_package_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Parent Package Version",
          "type": "string"
        },
        "parent_source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parent Source Digest",
          "type": "string"
        },
        "original_clause_links": {
          "items": {
            "$ref": "#/$defs/OriginalClauseLink"
          },
          "minItems": 1,
          "title": "Original Clause Links",
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "package_core": {
          "default": false,
          "title": "Package Core",
          "type": "boolean"
        },
        "core_selection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Core Selection Reason"
        },
        "value_type": {
          "const": "numeric",
          "title": "Value Type",
          "type": "string"
        },
        "value_constraints": {
          "$ref": "#/$defs/NumericConstraints"
        },
        "canonical_unit": {
          "minLength": 1,
          "title": "Canonical Unit",
          "type": "string"
        },
        "canonical_unit_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Canonical Unit Id",
          "type": "string"
        },
        "unit_dimension": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Unit Dimension",
          "type": "string"
        },
        "allowed_value_origins": {
          "items": {
            "enum": [
              "reported",
              "derived"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Value Origins",
          "type": "array"
        },
        "identity_axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Identity Axes",
          "type": "array"
        },
        "reported_required_axes": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minProperties": 1,
          "title": "Reported Required Axes",
          "type": "object"
        },
        "reported_context_axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reported Context Axes",
          "type": "array"
        },
        "context_unknown_policy": {
          "const": "preserve_missing_no_imputation",
          "title": "Context Unknown Policy",
          "type": "string"
        },
        "comparison_contract": {
          "$ref": "#/$defs/ComparisonContract"
        },
        "derivation_rules": {
          "items": {
            "$ref": "#/$defs/ExtensionDerivationRule"
          },
          "title": "Derivation Rules",
          "type": "array"
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Exclusions",
          "type": "array"
        },
        "output_policy": {
          "const": "explicit_selection_only",
          "default": "explicit_selection_only",
          "title": "Output Policy",
          "type": "string"
        },
        "reported_calculated_reconciliation": {
          "const": "retain_both_review_conflict",
          "default": "retain_both_review_conflict",
          "title": "Reported Calculated Reconciliation",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "extension_id",
        "definition_version",
        "parent_package_id",
        "parent_package_version",
        "parent_source_digest",
        "original_clause_links",
        "labels",
        "description",
        "rationale",
        "value_type",
        "canonical_unit",
        "canonical_unit_id",
        "unit_dimension",
        "allowed_value_origins",
        "identity_axes",
        "reported_required_axes",
        "reported_context_axes",
        "context_unknown_policy",
        "comparison_contract",
        "exclusions"
      ],
      "title": "ExtensionDefinition",
      "type": "object"
    },
    "ExtensionDerivationRule": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Rule Version",
          "type": "string"
        },
        "operation": {
          "const": "sum",
          "title": "Operation",
          "type": "string"
        },
        "operands": {
          "items": {
            "$ref": "#/$defs/OperandSelector"
          },
          "minItems": 2,
          "title": "Operands",
          "type": "array"
        },
        "shared_match_axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Shared Match Axes",
          "type": "array"
        },
        "target_axis_projections": {
          "items": {
            "$ref": "#/$defs/TargetAxisProjection"
          },
          "minItems": 1,
          "title": "Target Axis Projections",
          "type": "array"
        },
        "unit_policy": {
          "const": "reviewed_versioned_conversion_to_target_unit",
          "title": "Unit Policy",
          "type": "string"
        },
        "arithmetic": {
          "const": "exact_decimal_sum",
          "title": "Arithmetic",
          "type": "string"
        },
        "require_approved_operands": {
          "const": true,
          "default": true,
          "title": "Require Approved Operands",
          "type": "boolean"
        },
        "require_explicit_match_values": {
          "const": true,
          "default": true,
          "title": "Require Explicit Match Values",
          "type": "boolean"
        },
        "require_point_values": {
          "const": true,
          "default": true,
          "title": "Require Point Values",
          "type": "boolean"
        },
        "output_review_status": {
          "const": "pending",
          "default": "pending",
          "title": "Output Review Status",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "operation",
        "operands",
        "shared_match_axes",
        "target_axis_projections",
        "unit_policy",
        "arithmetic"
      ],
      "title": "ExtensionDerivationRule",
      "type": "object"
    },
    "ExtensionSelection": {
      "additionalProperties": false,
      "properties": {
        "extension_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Extension Id",
          "type": "string"
        },
        "definition_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Definition Version",
          "type": "string"
        },
        "release_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "selection_kind": {
          "default": "custom_extension",
          "enum": [
            "custom_extension",
            "package_core_extension",
            "platform_major_extension"
          ],
          "title": "Selection Kind",
          "type": "string"
        },
        "value_origins": {
          "items": {
            "enum": [
              "reported",
              "derived"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Origins",
          "type": "array"
        },
        "derivation_rule_ids": {
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Derivation Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "extension_id",
        "definition_version",
        "release_digest",
        "value_origins"
      ],
      "title": "ExtensionSelection",
      "type": "object"
    },
    "NumericConstraints": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "anyOf": [
            {
              "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        }
      },
      "title": "NumericConstraints",
      "type": "object"
    },
    "OperandSelector": {
      "additionalProperties": false,
      "properties": {
        "operand_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Operand Id",
          "type": "string"
        },
        "source_datapoint_id": {
          "minLength": 1,
          "title": "Source Datapoint Id",
          "type": "string"
        },
        "source_metric_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Metric Id",
          "type": "string"
        },
        "required_axes": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minProperties": 1,
          "title": "Required Axes",
          "type": "object"
        }
      },
      "required": [
        "operand_id",
        "source_datapoint_id",
        "source_metric_id",
        "required_axes"
      ],
      "title": "OperandSelector",
      "type": "object"
    },
    "OriginalClauseLink": {
      "additionalProperties": false,
      "properties": {
        "source_datapoint_id": {
          "minLength": 1,
          "title": "Source Datapoint Id",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "aggregate_component",
            "calculation_operand",
            "context"
          ],
          "title": "Relationship",
          "type": "string"
        }
      },
      "required": [
        "source_datapoint_id",
        "relationship"
      ],
      "title": "OriginalClauseLink",
      "type": "object"
    },
    "TargetAxisProjection": {
      "additionalProperties": false,
      "properties": {
        "target_axis": {
          "minLength": 1,
          "title": "Target Axis",
          "type": "string"
        },
        "from_operand_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Operand Id"
        },
        "source_axis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Axis"
        },
        "fixed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Value"
        }
      },
      "required": [
        "target_axis"
      ],
      "title": "TargetAxisProjection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "runtime-standard-snapshot-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "parent_package_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Parent Package Id",
      "type": "string"
    },
    "parent_package_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Parent Package Version",
      "type": "string"
    },
    "parent_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Source Digest",
      "type": "string"
    },
    "selections": {
      "items": {
        "$ref": "#/$defs/ExtensionSelection"
      },
      "minItems": 1,
      "title": "Selections",
      "type": "array"
    },
    "extension_releases": {
      "items": {
        "$ref": "#/$defs/CompiledExtension"
      },
      "minItems": 1,
      "title": "Extension Releases",
      "type": "array"
    },
    "runtime_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "parent_package_id",
    "parent_package_version",
    "parent_source_digest",
    "selections",
    "extension_releases",
    "runtime_digest"
  ],
  "title": "RuntimeStandardSnapshot",
  "type": "object"
}
