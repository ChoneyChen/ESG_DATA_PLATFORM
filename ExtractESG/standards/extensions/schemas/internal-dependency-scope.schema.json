{
  "$defs": {
    "FrozenExtensionOperandRole": {
      "additionalProperties": false,
      "properties": {
        "extension_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Extension Id",
          "type": "string"
        },
        "definition_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Definition Version",
          "type": "string"
        },
        "release_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Release Digest",
          "type": "string"
        },
        "derivation_rule_ids": {
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Derivation Rule Ids",
          "type": "array"
        },
        "role": {
          "const": "reviewed_publication_operand",
          "default": "reviewed_publication_operand",
          "title": "Role",
          "type": "string"
        },
        "internal_operand_metric_ids": {
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Internal Operand Metric Ids",
          "type": "array"
        },
        "selected_output_operand_metric_ids": {
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Selected Output Operand Metric Ids",
          "type": "array"
        }
      },
      "required": [
        "extension_id",
        "definition_version",
        "release_digest",
        "derivation_rule_ids",
        "internal_operand_metric_ids",
        "selected_output_operand_metric_ids"
      ],
      "title": "FrozenExtensionOperandRole",
      "type": "object"
    },
    "InternalMetricScope": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Metric Id",
          "type": "string"
        },
        "source_datapoint_id": {
          "title": "Source Datapoint Id",
          "type": "string"
        },
        "clause_kind": {
          "const": "original_datapoint",
          "default": "original_datapoint",
          "title": "Clause Kind",
          "type": "string"
        },
        "dependency_role": {
          "enum": [
            "calculation_operand",
            "standard_dependency"
          ],
          "title": "Dependency Role",
          "type": "string"
        },
        "required_by_extension_ids": {
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Required By Extension Ids",
          "type": "array"
        }
      },
      "required": [
        "metric_id",
        "source_datapoint_id",
        "dependency_role"
      ],
      "title": "InternalMetricScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "internal-dependency-facts-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_role": {
      "const": "internal_dependency",
      "default": "internal_dependency",
      "title": "Scope Role",
      "type": "string"
    },
    "output_policy": {
      "const": "excluded_from_selected_output_and_coverage",
      "default": "excluded_from_selected_output_and_coverage",
      "title": "Output Policy",
      "type": "string"
    },
    "parent_package_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Parent Package Id",
      "type": "string"
    },
    "parent_package_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Parent Package Version",
      "type": "string"
    },
    "parent_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Source Digest",
      "type": "string"
    },
    "runtime_standard_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Standard Digest",
      "type": "string"
    },
    "selected_output_metric_ids": {
      "items": {
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Selected Output Metric Ids",
      "type": "array"
    },
    "metric_ids": {
      "items": {
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Metric Ids",
      "type": "array"
    },
    "source_datapoint_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Datapoint Ids",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/InternalMetricScope"
      },
      "title": "Metrics",
      "type": "array"
    },
    "required_by_extensions": {
      "items": {
        "$ref": "#/$defs/FrozenExtensionOperandRole"
      },
      "title": "Required By Extensions",
      "type": "array"
    },
    "outcomes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "records": {
      "additionalProperties": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "title": "Records",
      "type": "object"
    },
    "core_bindings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Core Bindings",
      "type": "array"
    },
    "source_facts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Source Facts",
      "type": "array"
    },
    "evidence_references": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "contract_validation": {
      "additionalProperties": true,
      "title": "Contract Validation",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "parent_package_id",
    "parent_package_version",
    "parent_source_digest",
    "runtime_standard_digest",
    "selected_output_metric_ids",
    "metric_ids",
    "source_datapoint_ids",
    "metrics",
    "outcomes",
    "records",
    "core_bindings",
    "source_facts",
    "evidence_references",
    "contract_validation"
  ],
  "title": "InternalDependencyScope",
  "type": "object"
}
