# OCR provider routing. local_first is the default; API remains available as an
# explicit provider and an opt-in fallback. Do not commit real tokens.
ESG_V2_OCR_PROVIDER=local_first
PADDLEOCR_VL_API_TOKEN=
LOCAL_PADDLEOCR_RUNTIME_PYTHON=~/Desktop/model/.runtime/paddleocr-vl/bin/python
LOCAL_PADDLEOCR_MODEL_PATH=~/Desktop/model/PaddleOCR-VL-1.6
LOCAL_PADDLEOCR_PIPELINE_CACHE=~/Desktop/model/.cache/paddlex
LOCAL_PADDLEOCR_PIPELINE_VERSION=v1.6
LOCAL_PADDLEOCR_VLM_BACKEND=mlx-vlm-server
LOCAL_PADDLEOCR_VLM_SERVER_URL=http://127.0.0.1:8111/
LOCAL_PADDLEOCR_AUTOSTART_VLM_SERVER=true
LOCAL_PADDLEOCR_SERVER_START_TIMEOUT_SECONDS=60
LOCAL_PADDLEOCR_JOB_TIMEOUT_SECONDS=7200
QINIU_API_KEY=
QINIU_BASE_URL=
QINIU_VLM_MODEL=
# Provider-aware review pacing. TPD opens a persisted account/API-key circuit;
# RPM waits and retries inside the current task.
QINIU_MIN_REQUEST_INTERVAL_SECONDS=0.75
QINIU_RPM_BACKOFF_BASE_SECONDS=5
QINIU_RPM_MAX_WAIT_SECONDS=30
QINIU_TPD_RESET_GRACE_SECONDS=300
# 0 enables dynamic scheduling: all blocking tasks up to the blocking cap,
# followed by the separately capped optional queue.
ESG_V2_MAX_VLM_REVIEWS_PER_IR_RUN=0
ESG_V2_MAX_BLOCKING_VLM_REVIEWS_PER_IR_RUN=64
ESG_V2_MAX_OPTIONAL_VLM_REVIEWS_PER_IR_RUN=64
ESG_V2_REVIEW_COMPLETENESS_MODE=true
ESG_V2_DOCUMENT_IR_OUTPUT_DIR=
PADDLEOCR_VL_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_VL_POLL_INTERVAL=5
PADDLEOCR_VL_REQUEST_TIMEOUT=120
PADDLEOCR_VL_TRUST_ENV_PROXY=false
ESG_V2_OCR_PDF_CANVAS_NORMALIZATION=true
ESG_V2_OCR_PROVIDER_MAX_CANVAS_POINTS=1200
ESG_V2_OCR_PROVIDER_MAX_LOCAL_FILE_BYTES=104857600
ESG_V2_OCR_PROVIDER_MAX_PDF_PAGES=1000

# Local paths. Defaults point to document_ir_extract/ocr_output and
# document_ir_extract/.local/uploads.
ESG_V2_OCR_OUTPUT_DIR=
ESG_V2_UPLOAD_DIR=
ESG_V2_OCR_JOB_STATE_DIR=
ESG_V2_DOCUMENT_IR_JOB_STATE_DIR=
# Defaults beside local job-state roots, outside immutable package directories.
ESG_V2_STORAGE_CLEANUP_DIR=
