# PaddleOCR-VL API
# Do not commit real tokens.
PADDLEOCR_VL_API_TOKEN=
QINIU_API_KEY=
QINIU_BASE_URL=
QINIU_VLM_MODEL=
# Provider-aware review pacing. TPD opens a persisted account/API-key circuit;
# RPM waits and retries inside the current task.
QINIU_MIN_REQUEST_INTERVAL_SECONDS=0.75
QINIU_RPM_BACKOFF_BASE_SECONDS=5
QINIU_RPM_MAX_WAIT_SECONDS=30
QINIU_TPD_RESET_GRACE_SECONDS=300
# 0 enables dynamic scheduling: all blocking tasks up to the blocking cap,
# followed by the separately capped optional queue.
ESG_V2_MAX_VLM_REVIEWS_PER_IR_RUN=0
ESG_V2_MAX_BLOCKING_VLM_REVIEWS_PER_IR_RUN=64
ESG_V2_MAX_OPTIONAL_VLM_REVIEWS_PER_IR_RUN=64
ESG_V2_REVIEW_COMPLETENESS_MODE=true
ESG_V2_OCR_OUTPUT_DIR=
ESG_V2_DOCUMENT_IR_OUTPUT_DIR=
ESG_V2_EVIDENCE_OUTPUT_DIR=
ESG_V2_TARGETED_OUTPUT_DIR=
PADDLEOCR_VL_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_VL_POLL_INTERVAL=5
PADDLEOCR_VL_REQUEST_TIMEOUT=120
PADDLEOCR_VL_TRUST_ENV_PROXY=false

# Local paths. Defaults point to this module's output and .local directories.
ESG_V2_OCR_OUTPUT_DIR=
ESG_V2_UPLOAD_DIR=
