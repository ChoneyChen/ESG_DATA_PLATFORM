{
  "$defs": {
    "FieldBinding": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "source": {
          "enum": [
            "value",
            "identity",
            "dimension",
            "target",
            "resource",
            "fact",
            "evidence",
            "mapping",
            "extension"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "key"
      ],
      "title": "FieldBinding",
      "type": "object"
    },
    "JsonValue": {},
    "MatrixDefinition": {
      "additionalProperties": false,
      "properties": {
        "column_axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Column Axes",
          "type": "array"
        },
        "row_axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Row Axes",
          "type": "array"
        },
        "value_fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Fields",
          "type": "array"
        }
      },
      "required": [
        "row_axes",
        "column_axes",
        "value_fields"
      ],
      "title": "MatrixDefinition",
      "type": "object"
    },
    "OrganizationField": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/FieldBinding"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "required_for_confirmation": {
          "default": false,
          "title": "Required For Confirmation",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "raw_value",
            "parsed_value",
            "unit",
            "reported_identity",
            "reported_dimension",
            "target_definition",
            "resource_identity",
            "source_label",
            "provenance",
            "match_state",
            "annotation"
          ],
          "title": "Role",
          "type": "string"
        },
        "type_hint": {
          "default": "text",
          "enum": [
            "text",
            "decimal",
            "integer",
            "boolean",
            "date",
            "json"
          ],
          "title": "Type Hint",
          "type": "string"
        },
        "vocabulary": {
          "items": {
            "$ref": "#/$defs/VocabularyEntry"
          },
          "title": "Vocabulary",
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "role",
        "binding"
      ],
      "title": "OrganizationField",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "group_by": {
          "items": {
            "type": "string"
          },
          "title": "Group By",
          "type": "array"
        },
        "matrix": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatrixDefinition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sort_by": {
          "items": {
            "$ref": "#/$defs/SortField"
          },
          "title": "Sort By",
          "type": "array"
        },
        "view": {
          "default": "table",
          "enum": [
            "table",
            "statements",
            "matrix"
          ],
          "title": "View",
          "type": "string"
        }
      },
      "title": "Presentation",
      "type": "object"
    },
    "SortField": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "ascending",
          "enum": [
            "ascending",
            "descending"
          ],
          "title": "Direction",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "SortField",
      "type": "object"
    },
    "VocabularyEntry": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "code",
        "label"
      ],
      "title": "VocabularyEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "curation": {
      "default": "template",
      "enum": [
        "template",
        "sample"
      ],
      "title": "Curation",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/OrganizationField"
      },
      "minItems": 1,
      "title": "Fields",
      "type": "array"
    },
    "include_additional_dimensions": {
      "default": true,
      "title": "Include Additional Dimensions",
      "type": "boolean"
    },
    "include_extensions": {
      "default": true,
      "title": "Include Extensions",
      "type": "boolean"
    },
    "presentation": {
      "$ref": "#/$defs/Presentation"
    },
    "row_axes": {
      "items": {
        "type": "string"
      },
      "title": "Row Axes",
      "type": "array"
    },
    "schema_version": {
      "const": "clause-organization-1.0",
      "default": "clause-organization-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "fields"
  ],
  "title": "OrganizationSpec",
  "type": "object"
}
