          "title": "Search Coverage",
          "type": "string"
        },
        "target_facts": {
          "default": 0,
          "title": "Target Facts",
          "type": "integer"
        },
        "unresolved_facts": {
          "default": 0,
          "title": "Unresolved Facts",
          "type": "integer"
        }
      },
      "title": "ResultAssessment",
      "type": "object"
    },
    "RunError": {
      "additionalProperties": false,
