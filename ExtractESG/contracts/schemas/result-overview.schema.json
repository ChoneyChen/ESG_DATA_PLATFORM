    "JsonValue": {},
    "PeriodCoverage": {
      "additionalProperties": false,
      "properties": {
        "captured_facts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Captured Facts",
          "type": "object"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "observed_candidates": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Observed Candidates",
