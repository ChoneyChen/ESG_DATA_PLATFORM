          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Digest"
        },
        "returned": {
          "default": 0,
          "title": "Returned",
          "type": "integer"
        },
        "source_snapshot": {
          "title": "Source Snapshot",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "source_snapshot",
        "level"
      ],
      "title": "SearchQueryObservation",
      "type": "object"
