          "enum": [
            "quantitative",
            "qualitative"
          ],
          "title": "Data Kind",
          "type": "string"
        },
        "facts": {
          "title": "Facts",
          "type": "integer"
        },
        "relations": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Relations",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "clause_key",
        "title",
        "data_kind",
        "facts",
        "relations"
