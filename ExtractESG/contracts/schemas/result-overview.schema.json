        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        },
        "processed_clauses": {
          "title": "Processed Clauses",
          "type": "integer"
        },
        "qualitative": {
          "title": "Qualitative",
          "type": "integer"
        },
        "quantitative": {
          "title": "Quantitative",
          "type": "integer"
        },
        "selected_clauses": {
          "title": "Selected Clauses",
          "type": "integer"
        },
        "source_facts": {
          "title": "Source Facts",
          "type": "integer"
        }
      },
      "required": [
        "selected_clauses",
        "processed_clauses",
        "source_facts",
        "quantitative",
        "qualitative",
        "model_calls",
        "elapsed_seconds"
      ],
      "title": "RunSummary",
      "type": "object"
    },
