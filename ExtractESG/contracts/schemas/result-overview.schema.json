{
  "$defs": {
    "ClauseCoverage": {
      "additionalProperties": false,
      "properties": {
        "candidate_objects": {
          "default": 0,
          "title": "Candidate Objects",
          "type": "integer"
        },
        "clause_digest": {
          "title": "Clause Digest",
          "type": "string"
        },
        "clause_key": {
          "title": "Clause Key",
          "type": "string"
        },
        "covered_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Covered Scopes",
          "type": "array"
        },
        "fact_count": {
          "default": 0,
          "title": "Fact Count",
          "type": "integer"
        },
        "inspected_objects": {
          "default": 0,
          "title": "Inspected Objects",
          "type": "integer"
        },
        "periods": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeriodCoverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "required_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Required Scopes",
          "type": "array"
        },
        "search": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "covered",
            "unconfirmed",
            "not_found",
            "not_covered",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "clause_key",
        "clause_digest",
        "state"
      ],
      "title": "ClauseCoverage",
      "type": "object"
    },
    "ClauseResultSummary": {
      "additionalProperties": false,
      "properties": {
        "clause_key": {
          "title": "Clause Key",
          "type": "string"
